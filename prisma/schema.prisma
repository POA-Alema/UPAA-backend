generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum PubStatus {
  draft
  published
  archived
}

enum ImageType {
  planta_baixa
  fachada
  externa
  interna
}

// ==========================================
// EMBEDDED TYPES
// ==========================================

type I18nText {
  pt String
  en String
  de String
}

type PersonName {
  first String
  last  String
  full  String
}

type MediaAltText {
  pt String
  en String
  de String
}

type ArchitectMedia {
  portrait_url String
  alt_text     MediaAltText
}

type DateParts {
  day   Int
  month Int
  year  Int
  iso   String
}

type Place {
  city    String
  country String
}

type LifeEvent {
  date  DateParts
  place Place
}

type ArchitectCharacteristics {
  style      I18nText
  influences I18nText
  legacy     I18nText
}

type Coordinates {
  lat Float
  lng Float
}

type BuildingFeature {
  title       I18nText
  description I18nText
  icon_url    String
}

type MediaGalleryItem {
  url     String
  type    ImageType
  caption I18nText
}

type LandingCTA {
  label  I18nText
  target String
  icon   String
}

type ArchitectSection {
  imageURL      String
  imageSubtitle I18nText
  title         I18nText
  subtitle      I18nText
  content       I18nText
  CTA           LandingCTA
  order         Int
}

type ImmigrationSection {
  imageURL    String
  imgSubtitle I18nText
  title       I18nText
  subtitle    I18nText
  content     I18nText
  order       Int
}

type InstitutionItem {
  id          String
  title       I18nText
  description I18nText
  CTA         LandingCTA
  imageURL    String
  order       Int
}

type InstitutionsSection {
  title        I18nText
  institutions InstitutionItem[]
}

// ==========================================
// MODELS
// ==========================================

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  updatedLandingPages LandingPage[]

  createdArchitects Architect[] @relation("ArchitectCreatedBy")
  updatedArchitects Architect[] @relation("ArchitectUpdatedBy")

  createdBuildings Building[] @relation("BuildingCreatedBy")
  updatedBuildings Building[] @relation("BuildingUpdatedBy")

  @@map("admin_users")
}

model LandingPage {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  mainTitle I18nText
  subtitle  I18nText

  architectSection    ArchitectSection
  immigrationSection  ImmigrationSection?
  institutionsSection InstitutionsSection

  updatedBy   AdminUser @relation(fields: [updatedById], references: [id])
  updatedById String    @db.ObjectId
  updatedAt   DateTime  @updatedAt

  @@map("landing_page")
}

model Architect {
  id     String    @id @default(auto()) @map("_id") @db.ObjectId
  slug   String    @unique
  status PubStatus @default(draft)

  name            PersonName
  media           ArchitectMedia
  birth           LifeEvent
  death           LifeEvent?
  citizenship     String
  occupation      String
  about           I18nText
  characteristics ArchitectCharacteristics

  buildings Building[] @relation("ArchitectToBuilding")

  createdBy   AdminUser @relation("ArchitectCreatedBy", fields: [createdById], references: [id])
  createdById String    @db.ObjectId

  updatedBy   AdminUser @relation("ArchitectUpdatedBy", fields: [updatedById], references: [id])
  updatedById String    @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("architects")
}

model Building {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  slug      String    @unique
  status    PubStatus @default(draft)
  qrCodeKey String    @unique

  architect   Architect @relation("ArchitectToBuilding", fields: [architectId], references: [id])
  architectId String    @db.ObjectId

  name         I18nText
  originalName I18nText?
  location     I18nText
  coordinates  Coordinates

  constructionPeriod     String
  constructor            String?
  ornamentsAuthor        String?
  builtArea              String?
  currentOccupation      I18nText?
  restorationAndHeritage I18nText?

  description  I18nText
  history      I18nText
  features     BuildingFeature[]
  mediaGallery MediaGalleryItem[]
  sources      String[]

  createdBy   AdminUser @relation("BuildingCreatedBy", fields: [createdById], references: [id])
  createdById String    @db.ObjectId

  updatedBy   AdminUser @relation("BuildingUpdatedBy", fields: [updatedById], references: [id])
  updatedById String    @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("buildings")
}